{
  "name": "@xoxno/sdk-js",
  "version": "1.0.184",
  "description": "The SDK to interact with the XOXNO Protocol!",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.esm.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./stellar-lending": {
      "import": {
        "types": "./dist/sdk/stellar/index.d.ts",
        "default": "./dist/sdk/stellar/index.esm.js"
      },
      "require": {
        "types": "./dist/cjs/sdk/stellar/index.d.ts",
        "default": "./dist/sdk/stellar/index.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.esm.js",
  "files": [
    "dist/**/*"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "build:sdk": "npx bun run src/sdk/parseSwagger.ts && npx oxlint src/sdk/swagger.ts --fix && npx bun run md/extract.ts",
    "build:types": "tsc --emitDeclarationOnly && node scripts/emit-cjs-dts.mjs",
    "build:esm": "webpack --config webpack-esm.config.mjs",
    "build:cjs": "webpack --config webpack-cjs.config.mjs",
    "build": "npm run build:sdk && npm run build:types && npm run build:esm && npm run build:cjs",
    "verify:dist": "node -e \"const m=require('./dist/index.cjs'); if(typeof m.decodeStellarLendingEvent!=='function')throw new Error('CJS require broken'); console.log('CJS ok')\" && node --input-type=module -e \"import('./dist/index.esm.js').then(m=>{if(typeof m.decodeStellarLendingEvent!=='function')throw new Error('ESM import broken'); console.log('ESM ok')})\"",
    "prepublishOnly": "npm run verify:dist",
    "lint": "oxlint src",
    "format": "oxlint src --fix",
    "commit": "git-cz",
    "release": "semantic-release",
    "docs": "typedoc --out docs src/**/*.ts"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/XOXNO/sdk-js.git"
  },
  "husky": {
    "hooks": {
      "commit-msg": "npx --no-install commitlint --edit \"$1\"",
      "pre-commit": "npm run format && npm run lint && npm run docs",
      "pre-push": "npm test"
    }
  },
  "keywords": [
    "XOXNO",
    "MultiversX",
    "NFTs",
    "Blockchain",
    "Crypto"
  ],
  "author": "Mihai Eremia",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/XOXNO/sdk-js/issues"
  },
  "homepage": "https://github.com/XOXNO/sdk-js#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@multiversx/sdk-extension-provider": "^5.1.2",
    "@nestjs/common": "^11.1.24",
    "@nestjs/swagger": "^11.4.4",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@stellar/stellar-sdk": "^16.0.0",
    "@swc/cli": "^0.8.0",
    "@swc/core": "^1.15.11",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "bun": "^1.3.9",
    "commitizen": "^4.2.4",
    "cookies-next": "^6.1.1",
    "cz-conventional-changelog": "^3.3.0",
    "dts-bundle-generator": "^9.5.1",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "oxlint": "^1.47.0",
    "semantic-release": "^25.0.3",
    "swc-loader": "^0.2.7",
    "terser-webpack-plugin": "^5.3.16",
    "ts-jest": "^29.4.6",
    "ts-loader": "^9.5.4",
    "typedoc": "^0.28.17",
    "typescript": "^5.9.3",
    "webpack": "^5.105.2",
    "webpack-cli": "^6.0.1",
    "webpack-merge": "^6.0.1",
    "yaml": "^2.8.2"
  },
  "dependencies": {
    "@multiversx/sdk-core": "^15.3.2",
    "@multiversx/sdk-network-providers": "^2.9.3",
    "@xoxno/types": "^1.0.459"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=15.0.0 <17.0.0"
  }
}
